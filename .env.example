# ── 数据库（PostgreSQL 17，Spec ADR-007）──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/growth_studio

# ── 认证（JWT，Spec §4）──
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ── 模型适配层默认值（ADR-004；运行时可经设置页热切换，不改代码）──
# 主力：腾讯混元 Hy3 正式版（OpenAI 兼容端点，model 参数即 "hy3"，256K 上下文）
#   官方调用指南：cloud.tencent.com/document/product/1300/80695
#   价格：输入 ¥2 / 输出 ¥8 / 百万 tokens（缓存命中 0.8）
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hy3
# 省钱档（选题批量打分，完全免费）：hunyuan-lite
HUNYUAN_LITE_MODEL=hunyuan-lite
# 备选（配置切换）：智谱 GLM-4.7-Flash（免费，200K）/ 通义千问 Qwen3-Turbo
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# ── 采集（node-cron 独立 worker，AC-02/C-4）──
COLLECTION_CRON_EXPRESSION=0 */4 * * *
COLLECTION_MIN_INTERVAL_MIN=30
