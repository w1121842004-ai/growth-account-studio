# ── 生产环境变量模板 ──
# 用法：cp .env.production.example .env && vim .env（compose 默认读 .env）
# 注意：.env 含密钥，勿提交仓库（.dockerignore 已排除）

# ── 数据库（compose 内网连接，值会被 compose 覆盖为 db 服务名，保持占位即可）──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=growth_studio

# ── 认证 JWT（生产必换强随机值：openssl rand -hex 32）──
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ── 模型适配层（混元 Hy3 主力 + lite 免费档打分）──
# TokenHub 控制台申请：https://console.cloud.tencent.com/tokenhub/
HUNYUAN_BASE_URL=https://tokenhub.tencentmaas.com/v1
HUNYUAN_API_KEY=sk-xxxx
HUNYUAN_MODEL=hy3
HUNYUAN_LITE_MODEL=hunyuan-lite
# 备选（可选，不填则熔断后直接 503）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=

# ── 采集 worker（cron 表达式；空值/`disabled` 可停用定时采集）──
COLLECTION_CRON_EXPRESSION=0 */4 * * *
COLLECTION_MIN_INTERVAL_MIN=30

# ── 导出合规门禁（编辑距离阈值，默认 50，一般不动）──
# EDIT_DISTANCE_MIN=50
